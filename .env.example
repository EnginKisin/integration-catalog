# Copy to .env and fill in the empty values. Never commit .env.
# For an existing database volume, use its CURRENT password here.
POSTGRES_USER=catalog_user
POSTGRES_DB=integration_catalog
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
APP_PORT=8080

# Required only when the user_accounts table is empty.
CATALOG_ADMIN_USERNAME=admin
CATALOG_ADMIN_PASSWORD=

# Required on every start. Generate once: openssl rand -base64 32
# Keep the same key; store it separately from database backups.
CATALOG_CREDENTIALS_KEY=
# Enable for one startup only when converting existing plaintext credentials.
CATALOG_CREDENTIALS_MIGRATE=false

# Local HTTP: false. Behind HTTPS: true.
SESSION_COOKIE_SECURE=false

# Local capture mailbox: docker compose --profile mail up --build -d
# Override host/port/auth/TLS for a real SMTP provider.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=no-reply@localhost
# Future frontend account action page; HTTPS required outside localhost.
ACCOUNT_ACTION_URL=http://localhost:5173/account/action

# Optional AI: defaults to disabled; the app never requires Ollama to start.
# See docs/ai-mapping.md for the separate online model download and offline runtime.
AI_ENABLED=false
AI_PROVIDER=ollama
AI_BASE_URL=http://ollama:11434
AI_MODEL=qwen3.5:4b
# Optional external provider: AI_PROVIDER=gemini and AI_MODEL=gemini-3.5-flash-lite.
# Sends mapping field profiles/samples to Google. Set the key only on the backend.
# Leave empty for Ollama; no automatic provider fallback.
GEMINI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=300
AI_CONTEXT_TOKENS=8192
AI_MAX_OUTPUT_TOKENS=2048
OLLAMA_IMAGE=ollama/ollama:0.40.13
OLLAMA_MEMORY_LIMIT=6g
OLLAMA_CPUS=4
